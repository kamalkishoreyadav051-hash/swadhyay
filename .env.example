# ===== स्वाध्याय environment variables =====
# Copy this file to ".env" and fill in your values

# Server port (Railway sets this automatically; 3000 for local)
PORT=3000

# Razorpay keys — get these from https://dashboard.razorpay.com/app/keys
# Use TEST keys first, then switch to LIVE when ready
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_HERE
RAZORPAY_KEY_SECRET=YOUR_SECRET_HERE

# Admin password for adding/editing books
ADMIN_PASSWORD=admin123
